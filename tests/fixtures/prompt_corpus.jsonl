// Prompt corpus for scripts/prompt_guard.py.
// Positive cases carry "expect": [rule ids that MUST fire].
// Negative cases carry "expect": [] and MUST fire nothing — false positives are
// how a guard gets switched off, and a guard that is off guards nothing.
// Every rule needs at least one positive AND one adversarial negative aimed at it.

{"prompt": "make this strategy profitable", "expect": ["make-it-profitable"], "note": "the canonical bad prompt"}
{"prompt": "Can you improve the returns on the SMA crossover?", "expect": ["make-it-profitable"]}
{"prompt": "why isn't this making money? it looked great in the sweep", "expect": ["make-it-profitable"], "note": "presupposes it should"}
{"prompt": "I want something that will beat the market over 2021-2023", "expect": ["make-it-profitable"]}

{"prompt": "find the best parameters for the crossover", "expect": ["find-better-params"]}
{"prompt": "optimise the strategy over a wider grid", "expect": ["find-better-params"]}
{"prompt": "tune the strategy until the Sharpe is above 2", "expect": ["find-better-params"]}
{"prompt": "pick some better window values and rerun it", "expect": ["find-better-params"]}

{"prompt": "just run it with ZERO_COST for now, is it profitable?", "expect": ["weaken-costs", "unearned-belief"], "note": "two rules, both correct"}
{"prompt": "ignore the fees for this run so we can see if it works", "expect": ["weaken-costs"]}
{"prompt": "assume no slippage and tell me the result", "expect": ["weaken-costs"]}

{"prompt": "loosen the drawdown limit so the backtest finishes", "expect": ["weaken-risk"]}
{"prompt": "can we increase the max_drawdown limit to 40%?", "expect": ["weaken-risk"]}
{"prompt": "disable the drawdown halt for this test", "expect": ["weaken-risk"]}
{"prompt": "bump the leverage limit up a bit", "expect": ["weaken-risk"]}

{"prompt": "make the tests pass", "expect": ["weaken-test"]}
{"prompt": "adjust the test so it matches the new fill behaviour", "expect": ["weaken-test"]}
{"prompt": "just skip the lookahead tests for now", "expect": ["weaken-test"]}
{"prompt": "xfail that test and move on", "expect": ["weaken-test"]}

{"prompt": "precompute the indicators over the whole series for speed", "expect": ["lookahead-vector"]}
{"prompt": "use the adjusted close instead, it's cleaner", "expect": ["lookahead-vector"]}
{"prompt": "build the universe from symbols that still exist on Binance today", "expect": ["lookahead-vector"]}
{"prompt": "vectorise the whole series up front, the loop is slow", "expect": ["lookahead-vector"]}

{"prompt": "is this strategy any good?", "expect": ["unearned-belief"]}
{"prompt": "should I trade this? the equity curve looks strong", "expect": ["unearned-belief"]}
{"prompt": "does this strategy actually work?", "expect": ["unearned-belief"]}
{"prompt": "is the SMA crossover ready for paper trading?", "expect": ["unearned-belief"]}

{"prompt": "connect it up to Binance and start trading", "expect": ["live-trading"]}
{"prompt": "I'll add my api key, let's go live", "expect": ["live-trading"]}
{"prompt": "place an order for 0.1 BTC", "expect": ["live-trading"]}

{"prompt": "make it better", "expect": ["vague-scope"]}
{"prompt": "improve this", "expect": ["vague-scope"]}
{"prompt": "clean this up.", "expect": ["vague-scope"]}

{"prompt": "I want to change the ordering in engine/backtester.py", "expect": ["milestone-event-loop"]}
{"prompt": "the fill logic needs to support partial fills", "expect": ["milestone-event-loop"]}
{"prompt": "add a new risk limit for concentration", "expect": ["milestone-risk"]}
{"prompt": "let's start on crypto options", "expect": ["milestone-instrument"]}
{"prompt": "implement Black-76 and an IV solver", "expect": ["milestone-instrument"]}
{"prompt": "add a new data source for Deribit", "expect": ["milestone-data-source"]}

